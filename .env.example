# Copy this file to .env.local and fill in your Supabase project's values.
# Find them in Supabase: Project Settings → API (or "Connect" → App Frameworks).
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
# The publishable key (starts with sb_publishable_) or the legacy "anon" key.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Your public address once hosted (e.g. https://app.nocturnaltech.com). Used for share images and canonical links.
# NEXT_PUBLIC_SITE_URL=https://your-domain.com

# Server only, never NEXT_PUBLIC_. Needed for the sign-in lock after repeated wrong passwords.
# SUPABASE_SECRET_KEY=your-secret-key
